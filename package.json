{
  "name": "rforree",
  "version": "1.0.0",
  "description": "Warehouse Management System (WMS) — API, sync, and Vue floor console",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc",
    "build:web": "npm --prefix web run build",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RforRee/RforRee.git"
  },
  "keywords": [
    "wms",
    "warehouse",
    "prisma",
    "express"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RforRee/RforRee/issues"
  },
  "homepage": "https://github.com/RforRee/RforRee#readme",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
