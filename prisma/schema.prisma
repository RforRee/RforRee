generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Multi-tenant owner of warehouses and SKUs.
model Client {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  warehouses  Warehouse[]
  skus        Sku[]
}

/// Physical warehouse belonging to a client.
model Warehouse {
  id          String   @id @default(cuid())
  clientId    String
  code        String
  name        String
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  zones       Zone[]

  @@unique([clientId, code])
  @@index([clientId])
}

/// Logical area within a warehouse (e.g. receiving, storage, shipping).
model Zone {
  id          String    @id @default(cuid())
  warehouseId String
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins        Bin[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

/// Stock point / bin location within a zone.
model Bin {
  id        String   @id @default(cuid())
  zoneId    String
  code      String
  name      String?
  barcode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, code])
  @@index([zoneId])
}

/// Stock-keeping unit, scoped to a client (multi-tenant).
model Sku {
  id          String   @id @default(cuid())
  clientId    String
  code        String
  name        String
  description String?
  uom         String   @default("EA")
  barcode     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, code])
  @@index([clientId])
}
